datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TEACHER
}

enum AttendanceStatus {
  ATTENDED
  ABSENT
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         Role      @default(TEACHER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  teacher      Teacher?
}

model Teacher {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  specializations String[]     @default(["Guitar"])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  enrollments     Enrollment[]
}

model Student {
  id          String       @id @default(cuid())
  studentCode String       @unique
  fullName    String
  phone       String?
  parentPhone String?
  status      String       @default("ACTIVE")
  accessToken String       @unique @default(cuid())
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]
}

model PricingPlan {
  id               String       @id @default(cuid())
  subject          String
  packageName      String
  totalSessions    Int
  price            Decimal
  description      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  enrollments      Enrollment[]
}

model Enrollment {
  id                String          @id @default(cuid())
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId         String
  teacher           Teacher         @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  pricingPlanId     String
  pricingPlan       PricingPlan     @relation(fields: [pricingPlanId], references: [id], onDelete: Restrict)
  attendedSessions  Int             @default(0)
  totalSessions     Int
  tuitionFee        Decimal
  scheduleText      String?
  startDate         DateTime?       @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sessionLogs       SessionLog[]
}

model SessionLog {
  id                String       @id @default(cuid())
  enrollmentId      String
  enrollment        Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonDate        DateTime     @default(now())
  assignment        String?
  dueDate           DateTime?
  status            String       @default("Chưa xong")
  grade             String?      @default("Chưa kiểm tra")
  teacherEvaluation String?
  note              String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  attendance        Attendance?
}

model Attendance {
  id           String           @id @default(cuid())
  sessionLogId String           @unique
  sessionLog   SessionLog       @relation(fields: [sessionLogId], references: [id], onDelete: Cascade)
  status       AttendanceStatus @default(ATTENDED)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}